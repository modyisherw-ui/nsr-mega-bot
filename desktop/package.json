{
  "name": "nsr-desktop",
  "version": "1.0.0",
  "description": "NSR Dashboard — لوحة تحكم سطح المكتب للبوت",
  "main": "main.js",
  "author": "MoDy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/modyisherw-ui/nsr-mega-bot.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "mqtt": "^5.10.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nsr.dashboard",
    "productName": "NSR Dashboard",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NSR-Dashboard-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  }
}